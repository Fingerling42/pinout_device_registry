<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pinout_device_registry" model="ir.module.category">
        <field name="name">Pinout Device Registry</field>
        <field name="description">Access to Pinout device registry records and configuration.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_pinout_device_user" model="res.groups">
        <field name="name">Device Registry User</field>
        <field name="category_id" ref="module_category_pinout_device_registry"/>
    </record>

    <record id="group_pinout_device_manager" model="res.groups">
        <field name="name">Device Registry Manager</field>
        <field name="category_id" ref="module_category_pinout_device_registry"/>
        <field name="implied_ids" eval="[(4, ref('group_pinout_device_user'))]"/>
    </record>
</odoo>
