<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pinout_device_batch_create_wizard_owner_rule" model="ir.rule">
        <field name="name">Batch Create Devices: own wizard</field>
        <field name="model_id" ref="model_pinout_device_batch_create_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="pinout_device_batch_create_line_owner_rule" model="ir.rule">
        <field name="name">Batch Create Devices: own rows</field>
        <field name="model_id" ref="model_pinout_device_batch_create_line"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="inventory_audit_config_company_rule" model="ir.rule">
        <field name="name">Inventory Audit config: allowed companies</field>
        <field name="model_id" ref="model_pinout_inventory_audit_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="inventory_audit_scope_company_rule" model="ir.rule">
        <field name="name">Inventory Audit scope: allowed companies</field>
        <field name="model_id" ref="model_pinout_inventory_audit_scope"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="inventory_audit_group_company_rule" model="ir.rule">
        <field name="name">Inventory Audit group: allowed companies</field>
        <field name="model_id" ref="model_pinout_inventory_audit_group"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="inventory_audit_device_company_rule" model="ir.rule">
        <field name="name">Inventory Audit device: allowed companies</field>
        <field name="model_id" ref="model_pinout_inventory_audit_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
