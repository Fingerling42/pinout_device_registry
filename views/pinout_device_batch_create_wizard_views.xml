<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pinout_device_batch_create_wizard_view_form" model="ir.ui.view">
        <field name="name">pinout.device.batch.create.wizard.form</field>
        <field name="model">pinout.device.batch.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Batch Create Devices">
                <group>
                    <group>
                        <field name="device_type_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="allowed_product_template_ids" invisible="1"/>
                        <field name="current_product_id" domain="[('product_tmpl_id', 'in', allowed_product_template_ids)] if allowed_product_template_ids else []" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="state"/>
                        <field name="quality_status"/>
                    </group>
                    <group>
                        <field name="location_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="physical_location_note"/>
                        <field name="device_count"/>
                    </group>
                </group>
                <p>Paste tab-separated UID, MAC, Address columns, or one UID per line. MAC and Address are optional; keep tabs for empty cells. Address means Robonomics Device Address. Optional first-line header: UID / MAC / Address (separated by tabs). Empty lines are ignored. Parse replaces the table below; review and edit it before creating.</p>
                <field name="pasted_text" nolabel="1" placeholder="Paste spreadsheet rows here"/>
                <button name="action_parse" string="Parse / Replace Rows" type="object" class="btn-secondary"/>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" limit="100">
                        <field name="device_uid"/>
                        <field name="mac"/>
                        <field name="robonomics_device_address"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_create" string="Create Devices" type="object" class="btn-primary"/>
                    <button name="action_validate" string="Check Rows" type="object" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="pinout_device_batch_create_wizard_action" model="ir.actions.act_window">
        <field name="name">Batch Create Devices</field>
        <field name="res_model">pinout.device.batch.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="pinout_device_view_tree_batch_create" model="ir.ui.view">
        <field name="name">pinout.device.tree.batch.create</field>
        <field name="model">pinout.device</field>
        <field name="inherit_id" ref="pinout_device_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="%(pinout_device_batch_create_wizard_action)d" string="Batch Create" type="action" display="always" groups="base.group_user"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
