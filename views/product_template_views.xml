<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form_device_registry" model="ir.ui.view">
        <field name="name">product.template.form.device.registry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='traceability']" position="after">
                <group string="Device Registry" name="pinout_device_registry">
                    <field name="pinout_device_state_after_manufacturing"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
