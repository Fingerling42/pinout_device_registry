<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_lot_view_form_pinout_device" model="ir.ui.view">
        <field name="name">stock.lot.view.form.pinout.device</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field
                    name="pinout_device_id"
                    readonly="1"
                    invisible="not pinout_device_id"
                />
                <field
                    name="pinout_is_current_device_lot"
                    readonly="1"
                    invisible="not pinout_device_id"
                />
            </field>
        </field>
    </record>

    <record id="stock_lot_view_tree_pinout_device" model="ir.ui.view">
        <field name="name">stock.lot.view.tree.pinout.device</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="pinout_device_id" optional="hide" readonly="1"/>
                <field
                    name="pinout_is_current_device_lot"
                    optional="hide"
                    readonly="1"
                />
            </field>
        </field>
    </record>
</odoo>
