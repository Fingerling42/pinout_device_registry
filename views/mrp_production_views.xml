<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_view_form_device_registry" model="ir.ui.view">
        <field name="name">mrp.production.form.device.registry</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <field name="pinout_registry_available" invisible="1"/>
                <field name="pinout_allowed_device_type_ids" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='components']" position="after">
                <page
                    string="Device Registry"
                    name="pinout_device_registry"
                    invisible="not pinout_registry_available and not pinout_device_ids"
                >
                    <group>
                        <group>
                            <field name="pinout_source_product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="pinout_target_device_state" readonly="1"/>
                            <field name="pinout_device_count" readonly="1"/>
                        </group>
                    </group>
                    <field
                        name="pinout_device_ids"
                        domain="[('device_type_id', 'in', pinout_allowed_device_type_ids), ('bundle_id', '=', False), ('state', 'not in', ['reserved', 'sold', 'scrapped'])]"
                        options="{'no_create': True, 'no_create_edit': True}"
                        readonly="state in ['done', 'cancel']"
                    >
                        <tree create="false" edit="false">
                            <field name="device_uid"/>
                            <field name="device_type_id"/>
                            <field name="current_product_id"/>
                            <field name="variant_summary" optional="show"/>
                            <field name="state"/>
                            <field name="quality_status" optional="show"/>
                            <field name="bundle_id" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mrp_production_view_tree_device_registry" model="ir.ui.view">
        <field name="name">mrp.production.tree.device.registry</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="product_qty" position="after">
                <field name="pinout_device_count" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
