<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pinout_bundle_product_template_selection_view_tree" model="ir.ui.view">
        <field name="name">pinout.bundle.product.template.selection.view.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <field name="default_code" optional="show"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="pinout_bundle_product_template_selection_view_search" model="ir.ui.view">
        <field name="name">pinout.bundle.product.template.selection.view.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
                <field name="categ_id"/>
            </search>
        </field>
    </record>

    <record id="pinout_device_bundle_type_view_tree" model="ir.ui.view">
        <field name="name">pinout.device.bundle.type.view.tree</field>
        <field name="model">pinout.device.bundle.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="requires_kit_bom"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="pinout_device_bundle_type_view_form" model="ir.ui.view">
        <field name="name">pinout.device.bundle.type.view.form</field>
        <field name="model">pinout.device.bundle.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bundle_count" invisible="1"/>
                            <field
                                name="code"
                                placeholder="Generated from the name if empty"
                                readonly="bundle_count &gt; 0"
                            />
                        </group>
                        <group>
                            <field name="requires_kit_bom"/>
                            <field name="allow_any_product_form"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page
                            string="Product Forms"
                            name="product_forms"
                            invisible="allow_any_product_form"
                        >
                            <field
                                name="allowed_product_template_ids"
                                options="{'no_create': True, 'no_create_edit': True}"
                                context="{'tree_view_ref': 'pinout_device_registry.pinout_bundle_product_template_selection_view_tree', 'search_view_ref': 'pinout_device_registry.pinout_bundle_product_template_selection_view_search'}"
                            >
                                <tree>
                                    <field name="default_code" optional="show"/>
                                    <field name="name"/>
                                    <field name="detailed_type"/>
                                    <field name="tracking"/>
                                    <field name="product_variant_count"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pinout_device_bundle_type_view_search" model="ir.ui.view">
        <field name="name">pinout.device.bundle.type.view.search</field>
        <field name="model">pinout.device.bundle.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Requires Kit BoM" name="requires_kit_bom" domain="[('requires_kit_bom', '=', True)]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]" context="{'active_test': False}"/>
            </search>
        </field>
    </record>

    <record id="pinout_device_bundle_type_action" model="ir.actions.act_window">
        <field name="name">Bundle Types</field>
        <field name="res_model">pinout.device.bundle.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="pinout_device_bundle_type_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a bundle type
            </p>
        </field>
    </record>
</odoo>
