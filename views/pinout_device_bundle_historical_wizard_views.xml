<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pinout_device_bundle_historical_wizard_view_form" model="ir.ui.view">
        <field name="name">pinout.device.bundle.historical.wizard.view.form</field>
        <field name="model">pinout.device.bundle.historical.wizard</field>
        <field name="arch" type="xml">
            <form string="Reconstruct Historical Bundle">
                <group>
                    <field name="bundle_id"/>
                    <field name="bundle_product_id"/>
                    <field name="expected_product_ids" invisible="1"/>
                    <field name="eligible_device_ids" invisible="1"/>
                </group>
                <separator string="Expected Components"/>
                <field
                    name="expected_component_checklist"
                    nolabel="1"
                    readonly="1"
                />
                <separator string="Historical Devices"/>
                <field
                    name="device_ids"
                    nolabel="1"
                    domain="[('id', 'in', eligible_device_ids)]"
                    options="{'no_create': True, 'no_create_edit': True}"
                >
                    <tree>
                        <field name="device_uid"/>
                        <field name="current_product_id"/>
                        <field name="variant_summary"/>
                        <field name="state"/>
                        <field name="final_lot_id"/>
                        <field name="last_customer_id"/>
                        <field name="last_sale_order_id"/>
                        <field name="last_delivery_id"/>
                    </tree>
                </field>
                <footer>
                    <button
                        name="action_reconstruct"
                        string="Reconstruct Bundle"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
