<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pinout_device_batch_update_wizard_view_form" model="ir.ui.view">
        <field name="name">pinout.device.batch.update.wizard.view.form</field>
        <field name="model">pinout.device.batch.update.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="device_count" readonly="1"/>
                    </group>
                    <div class="overflow-auto mb-4" style="max-height: 24rem;">
                        <field
                            name="device_ids"
                            nolabel="1"
                            options="{'create': False}"
                        >
                            <tree string="Selected Devices" no_open="1" limit="40">
                                <control>
                                    <create string="Add Devices"/>
                                </control>
                                <field name="device_uid"/>
                                <field name="device_type_id"/>
                                <field name="current_product_id"/>
                                <field name="state"/>
                                <field name="quality_status"/>
                            </tree>
                        </field>
                    </div>
                    <group>
                        <group>
                            <field name="update_current_product"/>
                            <field
                                name="current_product_id"
                                invisible="not update_current_product"
                                required="update_current_product"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="update_state"/>
                            <field
                                name="state"
                                invisible="not update_state"
                                required="update_state"
                            />
                            <field name="update_quality_status"/>
                            <field
                                name="quality_status"
                                invisible="not update_quality_status"
                                required="update_quality_status"
                            />
                        </group>
                        <group>
                            <field name="update_location"/>
                            <field
                                name="location_id"
                                invisible="not update_location"
                                required="update_location"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field name="update_physical_location_note"/>
                            <field
                                name="physical_location_note"
                                invisible="not update_physical_location_note"
                            />
                            <field name="update_bundle"/>
                            <field
                                name="bundle_id"
                                invisible="not update_bundle"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pinout_device_batch_update_action" model="ir.actions.act_window">
        <field name="name">Batch Update Devices</field>
        <field name="res_model">pinout.device.batch.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="pinout_device_batch_update_server_action" model="ir.actions.server">
        <field name="name">Batch Update Devices</field>
        <field name="model_id" ref="model_pinout_device"/>
        <field name="binding_model_id" ref="model_pinout_device"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_batch_update_wizard()
        </field>
        <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
